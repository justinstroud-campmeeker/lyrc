SongBrowser {
    layout: vertical;
    width: 100%;
    height: 100%;
    padding: 0;
}

#browser-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    height: 1;
    background: $surface-darken-1;
    content-align: center middle;
}

#song-scroll {
    height: 1fr;
    background: $surface;
    border: none;
    padding: 0;
}

.song-btn {
    width: 100%;
    height: 1;
    border: none;
    background: transparent;
    color: $text;
    text-align: left;
    padding: 0 1;
    margin: 0;
}

.song-btn:hover {
    background: $primary 30%;
}

.song-btn:focus {
    background: $primary;
    color: $background;
    border: none;
}

#new-song-btn {
    dock: bottom;
    width: 100%;
    margin: 0;
}
